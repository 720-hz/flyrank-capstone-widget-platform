PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:3000

# 1 (default) = deterministic mock geo responses, no network calls needed.
# 0 = call the real free providers (ip-api.com, ipapi.co) for local dev.
MOCK_GEO=1

# Deterministic geo-provider toggles for demoing the fallback chain (see
# README / EVIDENCE.md). Leave both 0 for normal operation.
GEO_PROVIDER_A_DOWN=0
GEO_PROVIDER_B_DOWN=0

# Force the fake email side effect to throw, to demo that a failing
# side effect never blocks a submission from being stored.
EMAIL_FORCE_FAIL=0
